{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/front/**/*.ts",
    "src/front/**/*.tsx",
    "src/front/**/*.d.ts",
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/client/**/*.d.ts"
  ]
}
