# -----------------------------------------------------------------------------
# 로컬 PDFit 전용: Docker 서재 볼륨과 NAS/SMB 연결
# `pdfit` 컨테이너에서만 사용하며 Google Drive 서비스에는 사용하지 않습니다.
# SMB를 사용하지 않으면 PDFIT_SMB_* 값은 비워 둡니다.
# -----------------------------------------------------------------------------
PDFIT_BOOKS_VOLUME=pdfit-usbshare1
PDFIT_BOOKS_SUBPATH=이북
PDFIT_BOOKS_ROOT_NAME=이북
PDFIT_SMB_HOST=
PDFIT_SMB_SHARE=
PDFIT_SMB_PROXY_PORT=1445
PDFIT_SMB_USERNAME=
PDFIT_SMB_PASSWORD=

# -----------------------------------------------------------------------------
# PDFit 서비스 전용: Google OAuth 및 Google Drive
# `service` 컨테이너에서만 사용하며 로컬 파일 서재에는 사용하지 않습니다.
# -----------------------------------------------------------------------------
SERVICE_GOOGLE_REDIRECT_URI=https://pdfit.example.com/api/auth/callback
SERVICE_GOOGLE_CLIENT_ID=
SERVICE_GOOGLE_CLIENT_SECRET=
SERVICE_MAX_UPLOAD_MB=2048

# -----------------------------------------------------------------------------
# PDFit 서비스 전용: Paddle 결제
# 운영 환경에서는 BILLING_MOCK_ENABLED=false를 사용합니다.
# -----------------------------------------------------------------------------
BILLING_MOCK_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
