# -----------------------------------------------------------------------------
# 로컬 PDFit 전용: Docker 서재 볼륨과 NAS/SMB 연결
# `pdfit` 컨테이너에서만 사용하며 Google Drive 서비스에는 사용하지 않습니다.
# SMB를 사용하지 않으면 PDFIT_SMB_* 값은 비워 둡니다.
# -----------------------------------------------------------------------------
PDFIT_BOOKS_VOLUME=pdfit-usbshare1
PDFIT_BOOKS_SUBPATH=이북
PDFIT_BOOKS_ROOT_NAME=이북
PDFIT_SMB_HOST=
PDFIT_SMB_SHARE=
PDFIT_SMB_PROXY_PORT=1445
PDFIT_SMB_USERNAME=
PDFIT_SMB_PASSWORD=
PDFIT_STANDALONE_PORT=15203

# -----------------------------------------------------------------------------
# PDFit 서비스 전용: Google OAuth 및 Google Drive
# `service` 컨테이너에서만 사용하며 로컬 파일 서재에는 사용하지 않습니다.
# -----------------------------------------------------------------------------
SERVICE_GOOGLE_REDIRECT_URI=https://pdfit.example.com/api/auth/callback
SERVICE_LOCAL_ORIGIN=http://127.0.0.1:15201
SERVICE_GOOGLE_CLIENT_ID=
SERVICE_GOOGLE_CLIENT_SECRET=
SERVICE_MAX_UPLOAD_MB=2048

# Google Workspace Shared Drive의 지정 폴더를 읽는 공용 샘플 서재입니다.
# 권장 경로는 전용 서비스 계정입니다. JSON 키의 client_email과 private_key를
# 아래에 입력하고, PRIVATE_KEY의 실제 줄바꿈은 \n 문자열로 바꿉니다.
SERVICE_SAMPLE_DRIVE_ID=
SERVICE_SAMPLE_FOLDER_ID=
SERVICE_SAMPLE_CLIENT_EMAIL=
SERVICE_SAMPLE_PRIVATE_KEY=
  "client_email": "pdfit-sample-drive@pdfit-drive-api.iam.gserviceaccount.com",
SERVICE_SAMPLE_CACHE_TTL_SECONDS=300

# 하위 호환 경로입니다. 서비스 계정을 사용할 때는 비워 둡니다.
SERVICE_SAMPLE_OWNER_USER_ID=

# -----------------------------------------------------------------------------
# PDFit 서비스 전용: Paddle 결제
# 운영 환경에서는 BILLING_MOCK_ENABLED=false를 사용합니다.
# -----------------------------------------------------------------------------
BILLING_MOCK_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# PDFit 서비스 전용: 책 제목 기반 AI 자동 태그 (OpenAI 호환 API)
# 세 값을 모두 설정하면 외부 AI 의미 분류를 보조로 사용합니다. 기본 분류는 YES24 공개 상품 카테고리를 우선합니다.
# 예: https://api.openai.com/v1
# -----------------------------------------------------------------------------
SERVICE_AI_BASE_URL=
SERVICE_AI_MODEL=
SERVICE_AI_API_KEY=

# YES24 공식 Goods API 키. 설정하면 공개 상품 페이지 대신 공식 API로 제목을 먼저 확인하고
# 부제·책소개·목차를 분류 근거로 사용합니다. 로컬/서비스 Docker에 동일 적용됩니다.
YES24_API_KEY=
